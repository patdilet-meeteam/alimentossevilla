# ==============================================================================
# VARIABLES DE PRODUCCIÓN — copie a `.env.production` (ignorado por git) y
# complete. La aplicación NO arranca si falta el secreto o la URL pública.
# ==============================================================================

NODE_ENV=production

# URL pública con https. Better Auth solo acepta peticiones de este origen.
BETTER_AUTH_URL="https://nutricional.example.com"
NEXT_PUBLIC_APP_URL="https://nutricional.example.com"

# Secreto de sesiones: mínimo 32 caracteres, nunca el de .env.example.
#   openssl rand -base64 48
BETTER_AUTH_SECRET=""

# Base de datos (el compose arma DATABASE_URL con estos valores).
#   openssl rand -hex 24
POSTGRES_USER=alimentossevilla
POSTGRES_PASSWORD=""
POSTGRES_DB=alimentossevilla

# Red Docker del proxy HTTPS del servidor (debe existir).
RED_PROXY=proxy

# Administrador inicial: solo para `pnpm admin:bootstrap`. Bórrelas del archivo
# después del primer arranque.
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
