# ==============================================================================
# VARIABLES DE ENTORNO — PLATAFORMA ALIMENTOS SEVILLA
# Copie este archivo a `.env` y ajuste los valores según su entorno.
# NUNCA incluya contraseñas reales ni secretos de producción en el repositorio.
# ==============================================================================

# Entorno de ejecución (development | test | production)
NODE_ENV=development

# Puerto del servidor web
PORT=3000

# Puerto local expuesto para PostgreSQL en Docker Compose (permite evitar colisiones)
POSTGRES_PORT=5432

# Base de datos PostgreSQL
# Formato: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alimentossevilla?schema=public"

# Clave secreta para Better Auth y firma de sesiones (mínimo 32 caracteres).
# Este valor de ejemplo SOLO sirve en desarrollo: en producción la aplicación
# se niega a arrancar con él (ver .env.production.example).
BETTER_AUTH_SECRET="dev_secret_key_alimentos_sevilla_super_secure_32_chars_min"
AUTH_SECRET="dev_secret_key_alimentos_sevilla_super_secure_32_chars_min"

# URL base canónica de la aplicación
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciales del administrador inicial para el script de seed/bootstrap (SOLO DESARROLLO)
INITIAL_ADMIN_NAME="Administrador Sistema"
INITIAL_ADMIN_EMAIL="admin@alimentossevilla.com"
INITIAL_ADMIN_PASSWORD="AdminSevilla2026!#"
